        ]}, 

      { id:"buried", sceneLabel:"Chapter 2 · Scene 7", title:"Buried", img:"buried", 

        vocab:[{icon:"🕳️",word:"In the Pit"},{icon:"👥",word:"Farmers"},{icon:"⛰️",word:"Bury Him"},{icon:"⛰️",word:"Soil"},{icon:"🤖",word:"All Gone"},{icon:"☹️",word:"Hogarth Sad"}], 

        question:"Hogarth Sad", 

        options:[ 

          {icon:"☹️", text:"Hogarth Sad", correct:true}, 

          {icon:"😄", text:"Happy Face", correct:false} 

        ]} 

    ] 

  } 

}; 

 

var LEVEL_ORDER = ["red","green","jade"]; 

 

/* ========================================================== 

   STATE 

   ========================================================== */ 

var state = { name:"", levelKey:null, lessonIdx:0, journey:[], attemptsOnCurrent:0 }; 

var soundOn = true; 

 

var SPEEDS = [ 

  { label:"🐢 Slow",  rate:0.6,  title:"Slow"   }, 

  { label:"▶ Normal", rate:0.93, title:"Normal" }, 

  { label:"⚡ Fast",  rate:1.6,  title:"Fast"   }, 

  { label:"🚀 Turbo", rate:2.2,  title:"Turbo"  } 

]; 

var speedIdx = 1; 

var speechRate = SPEEDS[speedIdx].rate; 

 

/* ========================================================== 

   DOM REFERENCES 

   ========================================================== */ 

var stage    = document.getElementById("stage"); 

var trailEl  = document.getElementById("trail"); 

var soundBtn = document.getElementById("soundBtn"); 

var speedBtn = document.getElementById("speedBtn"); 

 

soundBtn.addEventListener("click", function () { 

  soundOn = !soundOn; 

  soundBtn.textContent = soundOn ? "🔊" : "🔇"; 

  if (!soundOn && window.speechSynthesis) window.speechSynthesis.cancel(); 

}); 

 

speedBtn.addEventListener("click", function () { 

  speedIdx = (speedIdx + 1) % SPEEDS.length; 

  speechRate = SPEEDS[speedIdx].rate; 

  speedBtn.textContent = SPEEDS[speedIdx].label; 

  speedBtn.title = "Playback speed: " + SPEEDS[speedIdx].title; 

  if (window.speechSynthesis) window.speechSynthesis.cancel(); 

}); 

 

/* ========================================================== 

   UTILITIES 

   ========================================================== */ 

function setAccent(color) { 

  document.documentElement.style.setProperty("--accent", color); 

} 

 

function setTrail(total, idx) { 

  trailEl.innerHTML = ""; 

  for (var i = 0; i < total; i++) { 

    var cls = i < idx ? "dot done" : i === idx ? "dot now" : "dot"; 

    trailEl.innerHTML += '<div class="' + cls + '"></div>'; 

  } 

} 

 

function clearTrail() { trailEl.innerHTML = ""; } 

 

function spokenNarrative(lesson) { 

  if (lesson.bullets) return lesson.bullets.join(". "); 

  if (lesson.vocab) return lesson.vocab.map(function (v) { return v.word; }).join(". "); 

  return lesson.narrative; 

} 

 

/* ========================================================== 

   SPEECH 

   ========================================================== */ 

function speak(text, onEnd) { 

  if (!soundOn || !window.speechSynthesis) { if (onEnd) onEnd(); return; } 

  try { 

    window.speechSynthesis.cancel(); 

    var u = new SpeechSynthesisUtterance(text); 

    u.lang = "en-GB"; 

    u.rate = speechRate; 

    var fired = false; 

    var done = function () { if (!fired) { fired = true; if (onEnd) onEnd(); } }; 

    u.onend = done; u.onerror = done; 

    var ms = Math.max(Math.ceil(text.length * 80 / speechRate) + 2000, 3000); 

    setTimeout(done, ms); 

    window.speechSynthesis.speak(u); 

  } catch (e) { 

    console.warn("TTS error:", e); 

    if (onEnd) onEnd(); 

  } 

} 

 

/* ========================================================== 

   SCREEN: WELCOME (Name Entry) 

   ========================================================== */ 

function renderWelcome() { 

  clearTrail(); 

  setAccent("#f0c040"); 

  state.name = ""; state.levelKey = null; state.lessonIdx = 0; state.journey = []; 

 

  stage.innerHTML = 

    '<div class="name-screen">' + 

      '<span class="hero">🤖</span>' + 

      '<h2>The Iron Man — Chapter 2</h2>' + 

      '<p>The Return of the Iron Man.<br><br>' + 

         'Read each part of the story.<br>' + 

         'Answer the question to carry on.<br><br>' + 

         'What is your name, reader?</p>' + 

      '<input class="text-input" id="nameIn" placeholder="Enter your name..." maxlength="30" autocomplete="off"/>' + 

      '<button class="btn btn-primary" id="startBtn">Continue →</button>' + 

    '</div>'; 

 

  var inp = document.getElementById("nameIn"); 

  var btn = document.getElementById("startBtn"); 

  inp.addEventListener("keydown", function (e) { if (e.key === "Enter") btn.click(); }); 

  btn.addEventListener("click", function () { 

    var n = (inp.value || "").trim(); 

    if (!n) { inp.focus(); inp.style.borderColor = "var(--red-no)"; return; } 

    state.name = n; 

    speak("Welcome, " + n + "!", function () { renderLevelSelect(); }); 

  }); 

} 

 

/* ========================================================== 

   SCREEN: LEVEL SELECTOR 

   ========================================================== */ 

function renderLevelSelect() { 

  clearTrail(); 

  setAccent("#f0c040"); 

 

  var cardsHtml = LEVEL_ORDER.map(function (key) { 

    var lvl = LEVELS[key]; 

    return ( 

      '<div class="level-card" id="level_' + key + '" tabindex="0" role="button" style="--lc-color:' + lvl.color + '" aria-label="' + lvl.name + ' Level">' + 

        '<span class="level-emoji">' + (lvl.badge === "JADE" ? "🟩" : lvl.badge === "GREEN" ? "🟢" : lvl.badge === "BLUE" ? "🔵" : "🔴") + '</span>' + 

        '<div class="level-name">' + lvl.name + ' Level</div>' + 

        '<div class="level-desc">' + lvl.desc + '</div>' + 

      '</div>' 

    ); 

  }).join(""); 

 

  stage.innerHTML = 

    '<div class="name-screen">' + 

      '<span class="hero">🤖</span>' + 

      '<h2>Hello, ' + state.name + '!</h2>' + 

      '<p>Choose your reading level to begin Chapter 2.</p>' + 

      '<div class="level-grid">' + cardsHtml + '</div>' + 

    '</div>'; 

 

  LEVEL_ORDER.forEach(function (key) { 

    var el = document.getElementById("level_" + key); 

    el.onclick = function () { selectLevel(key); }; 

    el.onkeydown = function (e) { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); selectLevel(key); } }; 

  }); 

} 

 

function selectLevel(key) { 

  state.levelKey = key; 

  state.lessonIdx = 0; 

  state.journey = []; 

  var lvl = LEVELS[key]; 

  setAccent(lvl.color); 

  speak(lvl.name + " Level. Let's begin!", function () { renderLesson(); }); 

} 

 

/* ========================================================== 

   SCREEN: LESSON (scene + gate question) 

   ========================================================== */ 

function renderLesson() { 

  var lvl = LEVELS[state.levelKey]; 

  var lesson = lvl.lessons[state.lessonIdx]; 

  state.attemptsOnCurrent = 0; 

  setTrail(lvl.lessons.length, state.lessonIdx); 

 

  var sceneHtml = ""; 

  if (lesson.bullets) { 

    sceneHtml = '<div class="scene-text bullets">' + 

      lesson.bullets.map(function (b) { return '<span class="bline">' + b + '</span>'; }).join("") + 

      '</div>'; 

  } else if (lesson.vocab) { 

    sceneHtml = '<div class="vocab-row">' + 

      lesson.vocab.map(function (v) { 

        return '<div class="vocab-chip"><span class="vi">' + v.icon + '</span><span class="vw">' + v.word.toUpperCase() + '</span></div>'; 

      }).join("") + 

      '</div>'; 

  } else { 

    sceneHtml = '<div class="scene-text">' + lesson.narrative + '</div>'; 

  } 

 

  var optionsHtml; 

  if (lvl.twoChoice) { 

    optionsHtml = '<div class="two-choice-grid" id="optGrid">' + 

      lesson.options.map(function (opt, i) { 

        return '<div class="two-choice-card" data-idx="' + i + '" tabindex="0" role="button">' + 

          '<span class="tc-icon">' + opt.icon + '</span>' + 

          '<span class="tc-label">' + opt.text.toUpperCase() + '</span>' + 

        '</div>'; 

      }).join(""); 

    optionsHtml += '</div>'; 

  } else { 

    optionsHtml = '<div class="opt-list" id="optGrid">' + 

      lesson.options.map(function (opt, i) { 

        return '<div class="opt-row" data-idx="' + i + '" tabindex="0" role="button">' + opt.text + '</div>'; 

      }).join("") + 

      '</div>'; 

  } 

 

  stage.innerHTML = 

    '<div class="scene-eyebrow">' + lesson.sceneLabel + '</div>' + 

    '<div class="scene-img-wrap">' + 

      '<div class="scene-emoji-slot">' + SCENE_EMOJI[lesson.img] + '</div>' + 

      '<div class="fade"></div>' + 

    '</div>' + 

    '<h3 style="font-size:20px;font-weight:800;margin-bottom:10px;">' + lesson.title + '</h3>' + 

    sceneHtml + 

    (lvl.twoChoice ? '<div class="question-label">Which one is ' + lesson.question.toUpperCase() + '?</div>' : '<div class="question-label">' + lesson.question + '</div>') + 

    optionsHtml + 

    '<div class="feedback" id="feedback"></div>'; 

 

  var toSpeak = (lesson.narrative || spokenNarrative(lesson)) + " " + (lvl.twoChoice ? "Which one is " + lesson.question + "?" : lesson.question); 

  speak(toSpeak); 

 

  var cardSelector = lvl.twoChoice ? ".two-choice-card" : ".opt-row"; 

  var cards = stage.querySelectorAll(cardSelector); 

  cards.forEach(function (card) { 

    card.addEventListener("click", function () { onAnswer(lesson, parseInt(card.getAttribute("data-idx"), 10), card, cards); }); 

    card.addEventListener("keydown", function (e) { 

      if (e.key === "Enter" || e.key === " ") { e.preventDefault(); onAnswer(lesson, parseInt(card.getAttribute("data-idx"), 10), card, cards); } 

    }); 

  }); 

} 

 

function onAnswer(lesson, idx, card, allCards) { 

  var opt = lesson.options[idx]; 

  state.attemptsOnCurrent++; 

  var fb = document.getElementById("feedback"); 

 

  if (opt.correct) { 

    card.classList.add("correct"); 

    allCards.forEach(function (c) { c.classList.add("disabled"); }); 

    fb.className = "feedback ok"; 

    fb.textContent = "That's right!"; 

    state.journey.push({ 

      scene: lesson.sceneLabel, title: lesson.title, 

      question: lesson.question, answer: opt.text, 

      firstTry: state.attemptsOnCurrent === 1 

    }); 

    speak("That's right!", function () { 

      setTimeout(function () { 

        var lvl = LEVELS[state.levelKey]; 

        if (state.lessonIdx < lvl.lessons.length - 1) { 

          state.lessonIdx++; 

          renderLesson(); 

        } else { 

          renderEnding(); 

        } 

      }, 500); 

    }); 

  } else { 

    card.classList.add("wrong"); 

    fb.className = "feedback no"; 

    fb.textContent = "Not quite — have another look and try again!"; 

    speak("Not quite. Try again."); 

    setTimeout(function () { card.classList.remove("wrong"); }, 900); 

  } 

} 

 

/* ========================================================== 

   SCREEN: ENDING 

   ========================================================== */ 

function renderEnding() { 

  var lvl = LEVELS[state.levelKey]; 

  clearTrail(); 

 

  var firstTryCount = state.journey.filter(function (j) { return j.firstTry; }).length; 

 

  var journeyHtml = state.journey.map(function (j) { 

    return '<div class="j-card">' + 

      '<div class="j-scene">' + j.scene + '</div>' + 

      '<div class="j-choice">' + j.answer + '</div>' + 

      '<div class="j-mark ' + (j.firstTry ? "first" : "retry") + '">' + (j.firstTry ? "✓ first try" : "✓ got there") + '</div>' + 

    '</div>'; 

  }).join(""); 

 

  stage.innerHTML = 

    '<div class="ending-screen">' + 

      '<span class="ending-emoji">🏆</span>' + 

      '<div class="ending-title">Well done, ' + state.name + '!</div>' + 

      '<div class="ending-score">' + firstTryCount + ' of ' + state.journey.length + ' answered first try &middot; ' + lvl.name + ' Level</div>' + 

      '<div class="ending-text" id="endTxt">' + lvl.endingText + '</div>' + 

      '<div class="journey-block">' + 

        '<div class="journey-eyebrow">📍 ' + state.name + "&#39;s journey</div>" + 

        '<div class="journey-grid">' + journeyHtml + '</div>' + 

      '</div>' + 

      '<div class="btn-row">' + 

        '<button class="btn btn-primary" id="readBtn">🔊 Read Aloud</button>' + 

        '<button class="btn btn-ghost"   id="pdfBtn">📄 Save as PDF</button>' + 

        '<button class="btn btn-ghost"   id="levelBtn">🔁 Change Level</button>' + 

        '<button class="btn btn-ghost"   id="againBtn">🔄 Play Again</button>' + 

      '</div>' + 

    '</div>'; 

 

  speak("Well done, " + state.name + "! " + lvl.endingText); 

 

  document.getElementById("readBtn").addEventListener("click", function () { 

    speak(state.name + "'s story. " + lvl.endingText); 

  }); 

  document.getElementById("pdfBtn").addEventListener("click", function () { savePDF(lvl); }); 

  document.getElementById("levelBtn").addEventListener("click", renderLevelSelect); 

  document.getElementById("againBtn").addEventListener("click", function () { 

    state.lessonIdx = 0; state.journey = []; renderLesson(); 

  }); 

} 

 

/* ========================================================== 

   PDF EXPORT 

   ========================================================== */ 

function savePDF(lvl) { 

  if (!window.jspdf || !window.jspdf.jsPDF) { 

    alert("PDF library not loaded. Please check your internet connection."); 

    return; 

  } 

  var jsPDF = window.jspdf.jsPDF; 

  var doc = new jsPDF({ unit:"pt", format:"a4", orientation:"portrait" }); 

  var pageWidth = 595.28, pageHeight = 841.89, margin = 54; 

  var contentWidth = pageWidth - margin * 2; 

 

  doc.setFillColor(250, 248, 245); 

  doc.rect(0, 0, pageWidth, pageHeight, "F"); 

  doc.setDrawColor(240, 192, 64); 

  doc.setLineWidth(1.5); 

  doc.line(margin, 110, pageWidth - margin, 110); 

  doc.line(margin, pageHeight - 75, pageWidth - margin, pageHeight - 75); 

 

  doc.setFont("Helvetica", "bold"); doc.setFontSize(22); doc.setTextColor(17, 17, 32); 

  doc.text("THE IRON MAN — CHAPTER 2", margin, 80); 

  doc.setFont("Helvetica", "normal"); doc.setFontSize(9); doc.setTextColor(94, 90, 78); 

  doc.text("The Return of the Iron Man — TIPS Reader", margin, 98); 

 

  var dateString = new Date().toLocaleDateString("en-GB", { day:"numeric", month:"long", year:"numeric" }); 

  var metaText = "Reader: " + state.name + "  |  " + lvl.name + " Level  |  " + dateString; 

  doc.setFont("Helvetica", "bold"); doc.setFontSize(9); doc.setTextColor(17, 17, 32); 

  doc.text(metaText, pageWidth - margin, 98, { align:"right" }); 

 

  var paragraphs = state.journey.map(function (j) { 

    return j.scene + " — " + j.title + ". Question: " + j.question + "  Answer: " + j.answer + (j.firstTry ? " (first try)" : ""); 

  }); 

 

  var fontSize = 10.5, lineSpacing = 15, paraSpacing = 12, startY = 140, maxY = 745; 

  var wrappedParas = [], wrappedEnding = []; 

 

  function computeLayout(fSize, lSpacing, pSpacing) { 

    doc.setFontSize(fSize); doc.setFont("Helvetica", "normal"); 

    var h = 0; wrappedParas = []; 

    for (var i = 0; i < paragraphs.length; i++) { 

      var lines = doc.splitTextToSize(paragraphs[i], contentWidth); 

      wrappedParas.push(lines); 

      h += lines.length * lSpacing; 

      if (i < paragraphs.length - 1) h += pSpacing; 

    } 

    h += 25 + 18; 

    wrappedEnding = doc.splitTextToSize(lvl.endingText, contentWidth); 

    h += wrappedEnding.length * lSpacing; 

    return h; 

  } 

 

  var totalHeight = computeLayout(fontSize, lineSpacing, paraSpacing); 

  while (startY + totalHeight > maxY && fontSize > 8) { 

    fontSize -= 0.5; lineSpacing -= 0.7; paraSpacing -= 0.5; 

    totalHeight = computeLayout(fontSize, lineSpacing, paraSpacing); 

  } 

 

  var currY = startY; 

  doc.setFontSize(fontSize); doc.setTextColor(17, 17, 32); 

  for (var i = 0; i < paragraphs.length; i++) { 

    var lines = wrappedParas[i]; 

    doc.setFont("Helvetica", "normal"); 

    for (var l = 0; l < lines.length; l++) { doc.text(lines[l], margin, currY); currY += lineSpacing; } 

    if (i < paragraphs.length - 1) currY += paraSpacing; 

  } 

 

  currY += paraSpacing + 4; 

  doc.setFont("Helvetica", "bold"); doc.setFontSize(fontSize + 1); doc.setTextColor(240, 192, 64); 

  doc.text("•   •   •", pageWidth / 2, currY, { align:"center" }); 

  currY += 20; 

 

  doc.setFont("Helvetica", "bold"); doc.setFontSize(fontSize); doc.setTextColor(240, 192, 64); 

  doc.text("WELL DONE, " + state.name.toUpperCase() + "!", margin, currY); 

  currY += 15; 

 

  doc.setFont("Helvetica", "normal"); doc.setTextColor(17, 17, 32); 

  for (var l = 0; l < wrappedEnding.length; l++) { doc.text(wrappedEnding[l], margin, currY); currY += lineSpacing; } 

 

  doc.setFont("Helvetica", "normal"); doc.setFontSize(8); doc.setTextColor(94, 90, 78); 

  doc.text("Talking in Pictures  |  SEND Resource  |  www.talkinginpictures.co.uk", margin, pageHeight - 55); 

 

  var fileBase = (state.name || "reader").replace(/[^a-z0-9]/gi, "_").toLowerCase(); 

  doc.save(fileBase + "_iron_man_ch2_" + lvl.key + ".pdf"); 

} 

 

/* ========================================================== 

   BOOT 

   ========================================================== */ 

renderWelcome(); 

</script> 

