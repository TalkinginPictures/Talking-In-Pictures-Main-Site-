<style> 

:root { 

  --bg:        #0a0a1a; 

  --card:      #12122a; 

  --surface:   #1a1a3e; 

  --surface2:  #0d0d24; 

  --accent:    #f0c040; 

  --accent-dim:#a08020; 

  --text:      #f0ece0; 

  --muted:     #5e5a6e; 

  --border:    rgba(240,192,64,0.13); 

  --green-ok:  #4caf7d; 

  --red-no:    #e84343; 

} 

*,*::before,*::after { box-sizing:border-box; margin:0; padding:0; } 

html, body { 

  min-height:100%; 

  font-family:'Segoe UI', system-ui, Arial, sans-serif; 

  background:radial-gradient(ellipse at 50% 0%, #1a1a3e 0%, var(--bg) 75%); 

  color:var(--text); 

  font-size:16px; 

  line-height:1.5; 

} 

.wrap { max-width:880px; margin:0 auto; padding:20px 14px 48px; } 

.card { 

  background:var(--card); 

  border-radius:18px; 

  border:1px solid var(--border); 

  box-shadow:0 28px 80px rgba(0,0,0,0.7); 

  padding:24px 24px 20px; 

} 

.game-header { 

  display:flex; align-items:flex-start; justify-content:space-between; 

  margin-bottom:22px; padding-bottom:18px; 

  border-bottom:1px solid var(--border); gap:12px; 

} 

.game-title { font-size:22px; font-weight:900; letter-spacing:0.3px; color:var(--text); } 

.game-title .accent-word { color:var(--accent); transition:color .3s; } 

.game-byline { font-size:11px; color:var(--muted); margin-top:4px; letter-spacing:0.5px; } 

.header-right { display:flex; flex-direction:column; align-items:flex-end; gap:10px; flex-shrink:0; } 

.header-controls { display:flex; gap:6px; align-items:center; } 

.speed-btn { padding:7px 11px; font-size:12px; font-weight:700; letter-spacing:0.2px; white-space:nowrap; } 

.trail { display:flex; gap:6px; align-items:center; flex-wrap:wrap; justify-content:flex-end; max-width:200px; } 

.dot { width:9px; height:9px; border-radius:50%; background:rgba(255,255,255,0.07); border:1px solid rgba(255,255,255,0.08); transition:background .3s, box-shadow .3s; } 

.dot.done { background:color-mix(in srgb, var(--accent) 55%, transparent); border-color:color-mix(in srgb, var(--accent) 55%, transparent); } 

.dot.now  { background:var(--accent); border-color:var(--accent); box-shadow:0 0 9px var(--accent); } 

.btn { padding:10px 16px; border-radius:10px; border:none; cursor:pointer; font-weight:700; font-size:14px; line-height:1; transition:opacity .15s, transform .1s; display:inline-flex; align-items:center; gap:6px; } 

.btn:hover  { opacity:.84; transform:translateY(-1px); } 

.btn:active { transform:translateY(0); } 

.btn-primary { background:linear-gradient(135deg, var(--accent), var(--accent-dim)); color:#07060a; } 

.btn-ghost   { background:rgba(255,255,255,0.05); color:var(--text); border:1px solid var(--border); } 

.btn-icon    { padding:8px 10px; font-size:18px; } 

.level-grid { display:grid; grid-template-columns:repeat(3, 1fr); gap:12px; margin-top:20px; } 

.level-card { 

  background:var(--surface); border-radius:12px; border:2px solid transparent; 

  cursor:pointer; padding:20px 16px; text-align:center; 

  transition:transform .15s, box-shadow .15s, border-color .15s; 

} 

.level-card:hover, .level-card:focus { 

  transform:translateY(-4px); 

  box-shadow:0 10px 30px rgba(0,0,0,.5), 0 0 0 1px var(--lc-color, var(--accent)); 

  border-color:var(--lc-color, var(--accent)); 

  outline:none; 

} 

.level-emoji { font-size:38px; display:block; margin-bottom:8px; } 

.level-name { font-size:16px; font-weight:700; color:var(--text); } 

.level-desc { font-size:12px; color:var(--muted); margin-top:4px; } 

.scene-eyebrow { font-size:11px; text-transform:uppercase; letter-spacing:2px; color:var(--accent); font-weight:700; margin-bottom:8px; } 

.scene-img-wrap { 

  width:100%; height:120px; border-radius:10px; background:var(--surface2); 

  overflow:hidden; position:relative; margin-bottom:14px; 

  display:flex; align-items:center; justify-content:center; 

} 

.scene-emoji-slot { font-size:64px; line-height:1; position:relative; z-index:1; } 

.fade { position:absolute; inset:0; background:linear-gradient(0deg, rgba(10,10,26,.92) 0%, rgba(10,10,26,.1) 100%); pointer-events:none; } 

.scene-text { 

  font-size:16px; line-height:1.75; color:#ddd6c8; padding:13px 16px; margin-bottom:16px; 

  border-left:3px solid var(--accent); border-radius:0 8px 8px 0; background:rgba(240,192,64,.04); 

} 

.scene-text.bullets { padding-left:16px; } 

.scene-text .bline { display:block; margin-bottom:6px; } 

.scene-text .bline:last-child { margin-bottom:0; } 

.vocab-row { display:flex; flex-wrap:wrap; gap:10px; margin-bottom:18px; } 

.vocab-chip { 

  display:flex; align-items:center; gap:8px; background:var(--surface2); 

  border:1px solid var(--border); border-radius:10px; padding:8px 12px; 

} 

.vocab-chip .vi { font-size:28px; line-height:1; } 

.vocab-chip .vw { font-size:14px; font-weight:700; letter-spacing:.3px; } 

.question-label { font-size:19px; font-weight:700; margin-bottom:12px; color:var(--text); } 

.opt-list { display:flex; flex-direction:column; gap:10px; } 

.opt-row { 

  background:var(--surface); border-radius:10px; border:1px solid rgba(255,255,255,0.05); 

  cursor:pointer; padding:14px 16px; font-size:15px; font-weight:600; color:var(--text); 

  transition:transform .12s, box-shadow .12s, border-color .12s, background .2s; 

  user-select:none; 

} 

.opt-row:hover, .opt-row:focus { transform:translateX(3px); box-shadow:0 6px 18px rgba(0,0,0,.4), 0 0 0 1px var(--accent); border-color:var(--accent); outline:none; } 

.opt-row.correct { background:rgba(76,175,125,.18); border-color:var(--green-ok); color:#bdf0d6; } 

.opt-row.wrong   { background:rgba(232,67,67,.16); border-color:var(--red-no); color:#ffc7c7; } 

.opt-row.disabled { pointer-events:none; opacity:.55; } 

.two-choice-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; } 

.two-choice-card { 

  background:var(--surface); border-radius:14px; border:3px solid rgba(255,255,255,0.08); 

  cursor:pointer; padding:26px 14px; text-align:center; 

  transition:transform .14s, box-shadow .14s, border-color .14s, background .2s; 

  user-select:none; 

} 

.two-choice-card:hover, .two-choice-card:focus { 

  transform:translateY(-4px); 

  box-shadow:0 10px 30px rgba(0,0,0,.5), 0 0 0 1px var(--accent); 

  border-color:var(--accent); outline:none; 

} 

.two-choice-card .tc-icon { font-size:64px; line-height:1; display:block; margin-bottom:12px; } 

.two-choice-card .tc-label { font-size:20px; font-weight:800; letter-spacing:.3px; } 

.two-choice-card.correct { background:rgba(76,175,125,.18); border-color:var(--green-ok); } 

.two-choice-card.wrong   { background:rgba(232,67,67,.16); border-color:var(--red-no); } 

.two-choice-card.disabled { pointer-events:none; opacity:.55; } 

.feedback { min-height:26px; font-size:15px; font-weight:700; text-align:center; margin-top:14px; } 

.feedback.ok  { color:var(--green-ok); } 

.feedback.no  { color:#ff9a9a; } 

.name-screen { text-align:center; padding:34px 16px 24px; } 

.name-screen .hero { font-size:58px; display:block; margin-bottom:14px; } 

.name-screen h2 { font-size:26px; font-weight:900; margin-bottom:10px; } 

.name-screen p { font-size:15px; color:#b0a898; line-height:1.7; margin-bottom:24px; max-width:440px; margin-left:auto; margin-right:auto; } 

.text-input { 

  padding:12px 16px; border-radius:10px; border:1px solid var(--border); 

  background:rgba(255,255,255,0.04); color:var(--text); font-size:16px; 

  width:260px; max-width:100%; outline:none; display:block; margin:0 auto 16px; 

} 

.text-input:focus { border-color:var(--accent); box-shadow:0 0 0 3px rgba(240,192,64,.14); } 

.ending-screen { text-align:center; padding:8px 4px; } 

.ending-emoji { font-size:58px; display:block; margin-bottom:10px; } 

.ending-title { font-size:25px; font-weight:900; margin-bottom:6px; color:var(--accent); } 

.ending-score { font-size:15px; color:var(--muted); margin-bottom:18px; } 

.ending-text { 

  font-size:16px; line-height:1.8; max-width:640px; margin:0 auto 20px; padding:18px 22px; 

  border-radius:12px; text-align:left; background:rgba(240,192,64,.07); border:1px solid var(--border); 

} 

.journey-block { margin:18px 0; text-align:left; } 

.journey-eyebrow { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1.5px; color:var(--muted); margin-bottom:10px; } 

.journey-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(180px,1fr)); gap:8px; } 

.j-card { background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06); border-radius:8px; padding:10px 12px; } 

.j-scene  { font-size:11px; color:var(--muted); margin-bottom:4px; } 

.j-choice { font-size:14px; font-weight:700; color:var(--text); } 

.j-mark   { font-size:12px; margin-top:4px; } 

.j-mark.first { color:var(--green-ok); } 

.j-mark.retry { color:#e0b060; } 

.btn-row { display:flex; gap:8px; flex-wrap:wrap; justify-content:center; margin-top:18px; } 

footer { margin-top:18px; text-align:center; font-size:11px; color:var(--muted); letter-spacing:0.3px; } 

@media (max-width:480px) { 

  .level-grid { grid-template-columns:1fr; } 

  .two-choice-grid { grid-template-columns:1fr; } 

} 

</style> 

